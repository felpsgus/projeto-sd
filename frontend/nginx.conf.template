# nginx — origem única HTTP do container do frontend (Etapa 13, D-40, D-32).
#
# GÊMEO de deploy/nginx/todolist.conf (mesmo conteúdo, dois destinos — este
# arquivo roda no container `frontend` do docker-compose/Cloud Run; o outro
# roda direto na VM via systemd/nginx no host, plano B até 22/10). Uma
# mudança de regra aqui precisa ser replicada lá, e vice-versa.
#
# Serve o build do Angular como estático e repassa /api/* para o Gateway, que
# nesta Etapa 13 deixou de publicar porta no host (só existe na rede interna
# do compose / privado no Cloud Run). O nginx NÃO autentica, NÃO valida
# payload e NÃO decide nada de negócio (D-40) — ele encaminha bytes; qualquer
# regra que apareça aqui está no lugar errado.
#
# Este arquivo é um TEMPLATE: o entrypoint padrão da imagem nginx
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) roda envsubst sobre
# /etc/nginx/templates/*.template e escreve o resultado em
# /etc/nginx/conf.d/default.conf antes do nginx subir.
#
# ATENÇÃO envsubst: sem proteção, envsubst substitui TODA sequência $NOME do
# arquivo, inclusive as variáveis do PRÓPRIO nginx ($uri, $host, $scheme,
# $proxy_add_x_forwarded_for) — elas não vêm de -e nenhuma, então viram string
# vazia. `try_files $uri $uri/ /index.html` viraria `try_files   /index.html`
# e o F5 numa rota profunda (/tasks, /login) passaria a devolver 404 do
# nginx, com a home continuando a carregar normalmente (sintoma silencioso).
# A defesa é a variável de ambiente NGINX_ENVSUBST_FILTER, fixada no
# Dockerfile para permitir só ${GATEWAY_UPSTREAM} — NÃO escape as variáveis
# do nginx aqui com $${...} ou \$; o filtro é o mecanismo previsto para isso.
server {
    listen 8080 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolvedor de DNS usado pelo proxy_pass do /api/ (ver a nota longa lá
    # embaixo). NGINX_LOCAL_RESOLVERS é montado pelo entrypoint da imagem a
    # partir do /etc/resolv.conf DESTE container — no compose é o DNS interno
    # do Docker, no Cloud Run é o resolver de lá. Nenhum IP fixo neste arquivo.
    # `valid=10s` é o tempo que um nome fica em cache: é o atraso máximo até o
    # nginx enxergar um container de gateway recriado com IP novo.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Headers de segurança básicos (BE-42 CA-08).
    #
    # ATENÇÃO nginx: add_header NÃO é herdado por um location que declare o seu
    # próprio add_header (ex.: Cache-Control) — "These directives are inherited
    # from the previous configuration level if and only if there are no
    # add_header directives defined on the current level" (doc. do módulo
    # ngx_http_headers_module). Por isso os três add_header abaixo são
    # REPETIDOS em `location = /index.html` e na location dos assets com hash,
    # que já têm o próprio Cache-Control. A location /api/ e a location / não
    # declaram add_header próprio, então continuam herdando normalmente daqui.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # CSP compatível com um Angular buildado em produção (AOT, sem eval):
    #   - script-src 'self': o build de produção não usa eval nem inline script,
    #     só <script src> apontando para os próprios bundles com hash;
    #   - style-src inclui 'unsafe-inline' porque a encapsulação de view do
    #     Angular injeta o CSS de cada componente como tag <style> em runtime
    #     (não é <link>) — sem isso a aplicação carrega sem nenhum estilo. Não
    #     há 'unsafe-eval' em lugar nenhum da política, que é o que a task pede
    #     para não relaxar sem registro;
    #   - connect-src 'self' cobre as chamadas a /api/* (mesma origem, D-21/D-32);
    #   - object-src/base-uri restritos por padrão, sem necessidade de exceção.
    #
    # Repetida (não herdada) em /index.html e nos assets, pelo mesmo motivo dos
    # dois headers acima. Deliberadamente NÃO repetida em location /api/: a CSP
    # é uma instrução para o navegador sobre como executar o DOCUMENTO HTML que
    # a carrega (de onde pode vir script, style, etc.); resposta de /api/ é
    # JSON puro, nunca renderizado como página, então a diretiva não tem efeito
    # ali e só acrescentaria bytes. O Gateway é quem decide os headers da sua
    # própria resposta (D-40 — nginx não decide nada de negócio).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # Compressão de texto — os tipos que o build do Angular efetivamente serve.
    # Deliberadamente simples (fora de escopo: cache de API, rate limiting).
    gzip on;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # index.html é o shell do SPA: precisa ser revalidado a cada carga, senão o
    # navegador guarda uma versão velha e o deploy novo nunca aparece (CA-07).
    # Este bloco também é o que responde quando try_files cai no fallback do
    # roteador do Angular (rota profunda, ex. /tasks) — nginx reaplica a busca
    # de location sobre a URI de destino do try_files.
    location = /index.html {
        # Repete os 3 headers de segurança do bloco server (ver comentário lá em
        # cima): como este location já declara o seu próprio add_header
        # (Cache-Control), o nginx para de herdar os do nível pai. Se o texto de
        # algum dos três mudar, mudar aqui também.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
        add_header Cache-Control "no-cache" always;
    }

    # Assets com hash no nome (padrão do build do Angular, outputHashing=all):
    # o hash na URL já garante que conteúdo novo tem URL nova, então podem ser
    # cacheados como imutáveis sem risco de servir versão velha (CA-07).
    location ~* \.(?:js|css|svg|png|jpg|jpeg|gif|ico|webp|woff2?|ttf|eot)$ {
        # Mesmo motivo do location = /index.html acima: este location também
        # declara o seu próprio add_header (Cache-Control), então precisa
        # repetir os 3 headers de segurança do bloco server, senão eles somem
        # justamente das respostas que carregam o CSS/JS da aplicação.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Fallback do SPA: toda rota que não é um arquivo físico (ex. /tasks,
    # /login) recarrega em index.html e deixa o Angular Router resolver no
    # cliente — sem isto, F5 numa rota profunda devolve 404 do nginx (CA-01).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy reverso da API (D-40): só repassa, nenhuma lógica. O Gateway
    # continua sendo o único ponto de entrada da API (D-32); daqui para a frente
    # é só encaminhamento de bytes. GATEWAY_UPSTREAM vem de variável de
    # ambiente (docker-compose: gateway:8080; Cloud Run/T3: a URL do serviço
    # Gateway) — é a ÚNICA substituição que o envsubst do entrypoint faz neste
    # arquivo (ver NGINX_ENVSUBST_FILTER no Dockerfile).
    #
    # ATENÇÃO — por que o upstream passa por uma variável do nginx
    # (diagnosticado e verificado em 25/09/2026):
    #
    # Escrito da forma óbvia — `proxy_pass http://${GATEWAY_UPSTREAM};`, com o
    # envsubst deixando um hostname LITERAL — o nginx resolve esse nome UMA
    # VEZ, ao subir, e guarda o IP para sempre. Isso dava dois problemas reais:
    #
    #   1. se o nome não resolvia na inicialização, o nginx ABORTAVA
    #      ("[emerg] host not found in upstream") e o container morria — a
    #      aplicação inteira saía do ar, não só o /api;
    #   2. recriar o container do gateway (`docker compose up -d --build
    #      gateway`) lhe dá um IP novo, e o nginx continuava mandando para o IP
    #      velho: /api passava a responder 502 sem nenhum erro no log do
    #      gateway — sintoma que manda você caçar bug no backend errado.
    #
    # Quando o proxy_pass contém uma VARIÁVEL, o nginx passa a resolver o nome
    # a cada requisição, usando a diretiva `resolver` do topo deste server. Os
    # dois problemas somem: subir sem o gateway agora serve o SPA normalmente e
    # só o /api responde 502, e um gateway recriado é reencontrado sozinho
    # dentro do `valid=` do resolver.
    #
    # DETALHE QUE NÃO PODE SER PERDIDO: com variável no proxy_pass, o nginx
    # para de montar a URI de destino automaticamente — sem o `$request_uri`
    # explícito, /api/tasks chegaria ao Gateway como "/" e toda a API
    # responderia 404. `$request_uri` é a URI original COM query string, que é
    # exatamente o que a forma literal enviava.
    #
    # O gêmeo deploy/nginx/todolist.conf NÃO precisa disto e continua com o
    # proxy_pass literal: lá o upstream é 127.0.0.1 (IP fixo, sem DNS). Esta é
    # a única divergência de regra deliberada entre os dois arquivos.
    location /api/ {
        set $api_upstream "http://${GATEWAY_UPSTREAM}";
        proxy_pass $api_upstream$request_uri;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Nenhum proxy_set_header para "traceparent": por padrão o nginx repassa
        # ao upstream todo header recebido que não é explicitamente sobrescrito
        # aqui. Mexer nisso quebraria a correlação de log ponta a ponta
        # (BE-39 CA-08) sem nenhum sintoma visível na resposta HTTP.

        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
