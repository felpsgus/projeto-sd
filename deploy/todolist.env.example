# Copie para `.env` (nome EXATO) em /opt/todolist/docker/, junto do docker-compose.prod.yml:
#   sudo cp todolist.env.example /opt/todolist/docker/.env && sudo chmod 600 /opt/todolist/docker/.env
# Só entra aqui o que é segredo ou específico deste ambiente; topologia fica no compose.
# Senha do banco: a política da instância exige um caractere não alfanumérico, e ela NÃO pode
# conter `;` nem `=` (quebram a connection string do Npgsql).

# Cloud SQL (IP privado, mesma VPC). A instância é `sslMode: ENCRYPTED_ONLY`: sem SSL a conexão é rejeitada.
# `Require` cifra mas não valida a CA; alvo futuro: `SSL Mode=VerifyFull;Root Certificate=<CA>` (deploy/cloudsql/README.md).
# Não use `Trust Server Certificate=true` junto de VerifyFull: desliga a validação sem avisar.
ConnectionStrings__IdentityDb=Host=<IP_PRIVADO_CLOUDSQL>;Port=5432;Database=todolist;Username=todolist;Password=TROQUE_ESTA_SENHA;SSL Mode=Require
ConnectionStrings__TasksDb=Host=<IP_PRIVADO_CLOUDSQL>;Port=5432;Database=todolist;Username=todolist;Password=TROQUE_ESTA_SENHA;SSL Mode=Require

# As mesmas credenciais em variáveis libpq: só o serviço `migrate` usa (o psql não lê formato Npgsql).
PGHOST=<IP_PRIVADO_CLOUDSQL>
PGPORT=5432
PGDATABASE=todolist
PGUSER=todolist
PGPASSWORD=TROQUE_ESTA_SENHA
PGSSLMODE=require

# Imagens publicadas por scripts/publish-images.ps1. Use a tag impressa por ele, não `latest`:
# `docker compose up -d` não reconsulta uma tag que já existe localmente e manteria a imagem antiga.
IMAGE_REGISTRY=us-central1-docker.pkg.dev/sd-26-2/todolist
IMAGE_TAG=<TAG_IMPRESSA_PELO_PUBLISH_IMAGES>
