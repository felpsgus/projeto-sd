# API Gateway — origem única HTTP (BE-36).
#
# Instalar em /etc/systemd/system/todolist-gateway.service (ver deploy/README.md).
#
# D-32: o Gateway é a UNICA porta alcancavel de fora da VPC. Identity e Tasks
# ficam atras dele, so por gRPC em 127.0.0.1 — nunca publicados diretamente.
#
# Emenda BE-42/D-40 (21/09/2026): isso deixou de valer para o próprio Gateway.
# Com o nginx assumindo a porta 80 como origem pública única da VM, o Gateway
# passa a escutar só em 127.0.0.1:8080 — alcançável apenas pelo nginx, na mesma
# máquina. D-33 ("Kestrel em 0.0.0.0:8080") fica superada neste ponto específico.
[Unit]
Description=TodoList API Gateway (origem unica HTTP)
Documentation=https://github.com/felpsgus/projeto-sd
After=network-online.target todolist-identity.service todolist-tasks.service
Wants=network-online.target

# Deliberadamente Wants=, nao Requires=: se um backend cair, o Gateway deve
# continuar de pe e devolver 503 (identity.unavailable / tasks.unavailable), nao
# morrer junto. Mesmo raciocinio do unit do Tasks em relacao ao Identity (D-28).
Wants=todolist-identity.service todolist-tasks.service

[Service]
Type=simple
User=todolist
Group=todolist
WorkingDirectory=/opt/todolist/gateway
ExecStart=/opt/todolist/gateway/TodoList.Gateway.Api

# O Gateway nao guarda segredo nenhum: desde BE-40 (D-38) ele valida o JWT
# localmente (AddJwtBearer) com a chave PUBLICA, que nao e segredo — fica em
# /etc/todolist/jwt/public.pem, modo 0444 (qualquer usuario da VM pode ler,
# inclusive o todolist), gerada por install-on-vm.sh junto da privada. Este
# arquivo tem os enderecos gRPC internos e Jwt__PublicKeyPath.
EnvironmentFile=/etc/todolist/gateway.env

# Chave publica JWT (BE-40, D-38). Nao e segredo (so verifica, nao assina), por
# isso nao precisa de LoadCredential= como a privada do Identity — o caminho
# fixo e suficiente.
Environment=Jwt__PublicKeyPath=/etc/todolist/jwt/public.pem

# BE-42/D-40: liga o Kestrel só em loopback. appsettings.json (dev local) ainda
# tem 0.0.0.0:8080 — não é tocado, pois vale para quem roda fora da VM; esta
# variável de ambiente sobrescreve só na VM, igual ao Jwt__PublicKeyPath acima.
# Fica na unit (fixa), não no gateway.env.example, pelo mesmo motivo do
# Jwt__PublicKeyPath: é uma decisão de topologia da VM, não um endereço que
# alguém deveria "preencher" ao copiar o .example.
Environment=Kestrel__Endpoints__Http__Url=http://127.0.0.1:8080

Restart=always
RestartSec=5
SyslogIdentifier=todolist-gateway

# Endurecimento basico, identico aos outros dois units.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
