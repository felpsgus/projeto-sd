# Identity Service — servidor gRPC (BE-26).
#
# Instalar em /etc/systemd/system/todolist-identity.service (ver deploy/README.md).
#
# Por que systemd e não `dotnet run` numa sessão SSH: o serviço precisa sobreviver
# à queda da conexão e voltar sozinho se o processo morrer. Uma sessão SSH que cai
# no meio da apresentação levaria os dois serviços junto.
[Unit]
Description=TodoList Identity Service (servidor gRPC)
Documentation=https://github.com/felpsgus/projeto-sd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=todolist
Group=todolist
WorkingDirectory=/opt/todolist/identity
ExecStart=/opt/todolist/identity/TodoList.Identity.Api

# Os segredos (connection string com a senha real do Postgres) ficam neste
# arquivo, com permissão 600 e dono root — nunca no unit, que é legível por
# qualquer usuário da VM, e nunca no repositório.
EnvironmentFile=/etc/todolist/identity.env

# Chave privada JWT RS256 (BE-40, D-38). As três units rodam como o MESMO
# usuário `todolist` — permissão de arquivo por dono não isola a chave privada
# do Gateway nem do Tasks (nenhum dos dois deveria conseguir lê-la). Por isso
# ela não é só mais uma linha em identity.env: fica em /etc/todolist/jwt/private.pem
# com dono root e modo 0400 (gerado por install-on-vm.sh), e chega SÓ a esta
# unit via LoadCredential= do systemd (>= 248 — Debian 12/Ubuntu 24.04 têm),
# que copia o arquivo para um diretório de credenciais exposto apenas ao
# processo desta unit. EnvironmentFile= não expande variáveis (%d não seria
# substituído se estivesse lá dentro), por isso o caminho vai aqui no unit.
LoadCredential=jwt-private:/etc/todolist/jwt/private.pem
Environment=Jwt__PrivateKeyPath=%d/jwt-private

Restart=always
RestartSec=5

# O Identity precisa estar de pé antes do Tasks: o Tasks sobe sem ele, mas
# devolve 503 na primeira criação (D-28, fail-closed). Ver a diretiva After= no
# unit do Tasks — esta linha aqui é só o par de log.
SyslogIdentifier=todolist-identity

# Endurecimento básico. ProtectSystem=full deixa /usr e /boot somente-leitura;
# não usamos "strict" porque ele tornaria todo o sistema de arquivos read-only e
# qualquer escrita temporária do runtime viraria uma falha difícil de diagnosticar
# na véspera da apresentação.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
