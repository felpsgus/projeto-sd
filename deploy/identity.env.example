# Identity Service — variáveis de ambiente da VM de aplicação (10.128.0.4).
#
# Copie para /etc/todolist/identity.env NA VM, preencha a senha real e trave:
#     sudo install -m 600 -o root -g root identity.env /etc/todolist/identity.env
#
# Este arquivo (.example) é versionado; identity.env NÃO é — o .gitignore já
# ignora *.env. Nunca commite o arquivo preenchido.
#
# Formato: systemd lê isto como KEY=VALUE literal. NÃO use aspas em volta do
# valor (elas viram parte do valor) e não use expansão de shell — $VAR não é
# interpretado aqui.

# Production é o padrão quando a variável não existe, mas deixamos explícito:
# em Development o serviço leria appsettings.Development.json e passaria a
# escutar em localhost, ficando inalcançável de fora da VM.
ASPNETCORE_ENVIRONMENT=Production

# Banco na VM de dados. TROQUE A SENHA — postgres/postgres é credencial de
# desenvolvimento local do docker-compose e não pode atravessar a rede.
ConnectionStrings__IdentityDb=Host=10.128.0.5;Port=5432;Database=todolist;Username=todolist;Password=TROQUE_ESTA_SENHA

# Persisted é o PADRÃO do próprio appsettings.json desde BE-40 (D-39) — deixado
# explícito aqui por documentação, não porque seja obrigatório sobrescrever.
# Com InMemory (restrito a teste, nunca a um ambiente de deploy) o Identity
# aprovaria por gRPC um dono que não existe em identity.users, e a criação da
# tarefa quebraria só no INSERT, na FK cruzada — falha tardia, no pior momento
# possível; pior ainda no T2, cujo enunciado proíbe dado em memória na demo.
UserStore__Provider=Persisted

# Onda E (T2): o seed de demonstração (DemoUserSeeder,
# UserStore__SeedDemoUsers/UserStore__DemoUserPassword) foi removido — agora
# que existe cadastro real (POST /api/auth/register, fase 3), não fazia mais
# sentido manter um atalho que o próprio código avisava para "nunca ligar em
# produção" ligado por padrão neste arquivo. Cadastre as contas do roteiro
# pela tela ou por scripts/demo-t2.ps1; a conta usada para demonstrar
# RN-AUTH-09 (usuário inativo) é criada por um UPDATE direto no banco — ver
# deploy/README.md, seção "No dia da apresentação".

# Chave de assinatura dos tokens JWT — desde BE-40 (D-38/RS256), NÃO é mais uma
# variável de ambiente aqui. A chave privada (Jwt:PrivateKeyPath) é um arquivo
# PEM gerado por `install-on-vm.sh` em /etc/todolist/jwt/private.pem (dono
# root, modo 0400) e chega a esta unit só via `LoadCredential=` do systemd —
# ver deploy/todolist-identity.service. Nada a preencher neste .env: se algum
# dia uma chave Jwt:* parecer necessária aqui, o desenho mudou e a decisão
# precisa ser revista antes de editar este arquivo.

# Issuer/Audience — opcionais: appsettings.json já traz o padrão
# (todolist-identity / todolist). Descomente só para sobrescrever.
# Jwt__Issuer=todolist-identity
# Jwt__Audience=todolist

# Endpoints: o appsettings.json base já declara 0.0.0.0:5080 (REST) e
# 0.0.0.0:5081 (gRPC, Protocols=Http2). Descomente só para mover as portas.
# Kestrel__Endpoints__Http__Url=http://0.0.0.0:5080
# Kestrel__Endpoints__Grpc__Url=http://0.0.0.0:5081

# Onde o runtime .NET foi instalado. Só é necessário se o serviço falhar com
# "framework not found" mesmo com `dotnet --list-runtimes` respondendo certo — o
# caminho normal é registrar em /etc/dotnet/install_location (seção 3 do runbook).
# Ajuste o valor ao local real: /usr/share/dotnet (dotnet-install.sh) ou
# /usr/lib/dotnet (pacote apt).
# DOTNET_ROOT=/usr/share/dotnet
