# Tasks Service — variáveis de ambiente da VM de aplicação (10.128.0.4).
#
# Copie para /etc/todolist/tasks.env NA VM, preencha a senha real e trave:
#     sudo install -m 600 -o root -g root tasks.env /etc/todolist/tasks.env
#
# Este arquivo (.example) é versionado; tasks.env NÃO é. Sem aspas nos valores.

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__TasksDb=Host=10.128.0.5;Port=5432;Database=todolist;Username=todolist;Password=TROQUE_ESTA_SENHA

# O Identity roda na MESMA VM, então o salto gRPC é interno — 127.0.0.1, não o
# IP da VM. Isso mantém a porta 5081 fora da rede mesmo se a regra de firewall
# for permissiva demais.
Identity__GrpcAddress=http://127.0.0.1:5081

# Portas do Tasks (D-37): 5100 é Http1, só para /health, operado por humano
# (curl) — não é necessária no Cloud Run e não deve ser aberta para a internet.
# 5101 é Http2 pura (sem TLS não há ALPN para negociar HTTP/2 numa porta que
# também aceita HTTP/1.1) e é por onde passa TODO o tráfego real do serviço —
# CreateTask e o que mais existir. Alcançada só pelo Gateway, via 127.0.0.1
# (D-32/D-34): a porta 5101 nunca deve ficar acessível de fora da VPC.

# 5s em vez dos 2s do appsettings: numa VM pequena a primeira chamada paga
# conexão HTTP/2 + primeira query do EF Core. Medido em máquina de
# desenvolvimento, esse custo foi de ~260ms — folgado dentro dos 2s —, mas a VM
# é mais lenta e a margem extra não custa nada. Um deadline que expira na
# primeira requisição da apresentação é o pior desfecho possível.
Identity__GrpcTimeoutSeconds=5

# Kestrel__Endpoints__Http__Url=http://0.0.0.0:5100
# Kestrel__Endpoints__Grpc__Url=http://0.0.0.0:5101

# Onde o runtime .NET foi instalado. Só é necessário se o serviço falhar com
# "framework not found" mesmo com `dotnet --list-runtimes` respondendo certo — o
# caminho normal é registrar em /etc/dotnet/install_location (seção 3 do runbook).
# DOTNET_ROOT=/usr/share/dotnet
