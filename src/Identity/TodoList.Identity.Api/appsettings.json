{
  "Service": {
    "DisplayName": "Identity Service"
  },
  "UserStore": {
    "Provider": "Persisted"
  },
  "PasswordHashing": {
    "Iterations": 600000
  },
  "Lockout": {
    "Enabled": true,
    "MaxAttempts": 5,
    "LockoutMinutes": 15,
    "AttemptWindowMinutes": 15
  },
  "Auth": {
    "TokenRetentionDays": 30
  },
  "Jwt": {
    "Issuer": "todolist-identity",
    "Audience": "todolist"
  },
  "Retention": {
    "Enabled": true,
    "IntervalHours": 24,
    "BatchSize": 500
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5081",
        "Protocols": "Http2"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
