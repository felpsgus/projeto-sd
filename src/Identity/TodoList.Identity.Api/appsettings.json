{
  "Service": {
    "DisplayName": "Identity Service"
  },
  "UserStore": {
    "Provider": "InMemory"
  },
  "PasswordHashing": {
    "Iterations": 600000
  },
  "Jwt": {
    "Issuer": "todolist-identity",
    "Audience": "todolist"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5081",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
