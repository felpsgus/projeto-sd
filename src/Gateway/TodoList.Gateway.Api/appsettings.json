{
  "Backends": {
    "IdentityGrpcAddress": "http://localhost:5081",
    "TasksGrpcAddress": "http://localhost:5101",
    "IdentityGrpcTimeoutSeconds": 2,
    "TasksGrpcTimeoutSeconds": 5
  },
  "Jwt": {
    "Issuer": "todolist-identity",
    "Audience": "todolist"
  },
  "ForwardedHeaders": {
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "Paging": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
