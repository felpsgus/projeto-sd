{
  "Backends": {
    "IdentityGrpcAddress": "http://localhost:5081",
    "TasksGrpcAddress": "http://localhost:5101",
    "IdentityGrpcTimeoutSeconds": 2,
    "TasksGrpcTimeoutSeconds": 5
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
