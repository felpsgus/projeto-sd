<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- BE-36, D-33: um único projeto Web, sem Domain/Application/Infrastructure
       — o Gateway não tem regra de negócio própria, só traduz e delega
       (CA-20/CA-21). Nenhuma <ProjectReference> a TodoList.Identity.* /
       TodoList.Tasks.* / TodoList.SharedKernel: os dois .proto abaixo são a
       ÚNICA fonte de tipos compartilhados com os backends. -->

  <ItemGroup>
    <!-- Lado cliente dos dois contratos gRPC (D-32): caminho relativo direto
         para contracts/, sem cópia local em nenhum serviço (mesmo padrão do
         lado servidor em TodoList.Tasks.Api/TodoList.Identity.Api). -->
    <Protobuf Include="..\..\..\contracts\identity\v1\identity.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\contracts\tasks\v1\tasks.proto" GrpcServices="Client" />
  </ItemGroup>

  <!-- BE-24: logging estruturado compartilhado. Compilado aqui como arquivo (sem ProjectReference)
       porque o Gateway não referencia o SharedKernel (D-33). -->
  <ItemGroup>
    <Compile Include="..\..\Shared\TodoList.SharedKernel.Web\StructuredLogging.cs" Link="Logging\StructuredLogging.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!-- BE-40, D-38: AddJwtBearer valida o token localmente com a chave
         pública RSA do Identity — substitui o esquema "IdentityToken" que
         perguntava via gRPC (ValidateToken) a cada requisição. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
