{
  "Service": {
    "DisplayName": "Tasks Service"
  },
  "Identity": {
    "GrpcAddress": "http://localhost:5081",
    "GrpcTimeoutSeconds": 2
  },
  "Tasks": {
    "MaxActivePerUser": 500
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5100",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5101",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
