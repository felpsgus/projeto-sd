<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tasks\TodoList.Tasks.Api\TodoList.Tasks.Api.csproj" />
    <!-- Servidor real do Identity (BE-26), usado nos testes de integração do
         cliente gRPC (BE-27, CA-04, CA-07, CA-09, CA-13). Alias porque tanto
         o Identity quanto o Tasks têm sua própria classe `Program` (sem
         namespace) e seu próprio código gerado a partir do mesmo .proto
         (D-29) — sem o alias, os dois colidiriam por nome nesta compilação. -->
    <ProjectReference Include="..\..\src\Identity\TodoList.Identity.Api\TodoList.Identity.Api.csproj">
      <Aliases>IdentityApi</Aliases>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <!-- Cliente gRPC dos testes (BE-35), mesmo pacote de
         TodoList.Identity.IntegrationTests: GrpcChannel.ForAddress sobre o
         handler do WebApplicationFactory, sem porta TCP real. -->
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- SQLite in-memory (BE-02): exercita o pipeline relacional real do EF
         (SaveChanges, interceptors, query filters) sem Postgres/Docker — só
         nos projetos de teste, nunca em produção. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- FakeTimeProvider (CA-08 de BE-02): avança o tempo sem Thread.Sleep. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <!-- Testcontainers (CA-09 de BE-02): usado só pelos testes marcados
         [Fact(Skip=...)]/[Trait("Category","Docker")] — não rodam nesta
         rodada (restrição de bateria), mas o código precisa compilar. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
