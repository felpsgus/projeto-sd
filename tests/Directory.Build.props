<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <!-- CA1707 proíbe underscore em nomes de membros, mas a convenção de testes
         (CONVENCOES-CODIGO.md, seção 4.2) é Metodo_Cenario_ResultadoEsperado. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Coleta de cobertura (BE-24 CA-12): usada por scripts/coverage.ps1 com coverlet.runsettings. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
