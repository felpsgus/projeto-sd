<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Identity\TodoList.Identity.Api\TodoList.Identity.Api.csproj" />
    <!-- BE-16, CA-04/CA-05/CA-08: a prova da cascata `tasks.tasks.owner_id →
         identity.users(id) ON DELETE CASCADE` (D-27) exige consultar
         tasks.tasks pelo TasksDbContext real — não há como verificar isso
         só com o Identity. Referência só de teste, nunca de src/Identity/**
         (a barreira de D-27/CA-13 continua valendo em produção).
         `Aliases=TasksInfra`: TodoList.Tasks.Infrastructure gera, do mesmo
         identity.proto (lado Client), os mesmos tipos de mensagem que
         TodoList.Identity.Api gera (lado Server) — sem alias, os dois
         assemblies na mesma compilação colidem (CS0433) mesmo sem uso direto.
         O alias exige `extern alias TasksInfra;` em quem precisa de
         TasksDbContext/TodoTask, sem afetar o restante do projeto de teste. -->
    <ProjectReference Include="..\..\src\Tasks\TodoList.Tasks.Infrastructure\TodoList.Tasks.Infrastructure.csproj">
      <Aliases>TasksInfra</Aliases>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- SQLite in-memory (BE-02): exercita o pipeline relacional real do EF
         (SaveChanges, interceptors, query filters) sem Postgres/Docker — só
         nos projetos de teste, nunca em produção. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- FakeTimeProvider (CA-08 de BE-02): avança o tempo sem Thread.Sleep. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <!-- Testcontainers (CA-09 de BE-02): usado só pelos testes marcados
         [Fact(Skip=...)]/[Trait("Category","Docker")] — não rodam nesta
         rodada (restrição de bateria), mas o código precisa compilar. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
